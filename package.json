{
  "name": "xorgate-core-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.cdk.json",
    "watch": "tsc -p tsconfig.cdk.json --watch",
    "cdk": "cdk",
    "synth": "cdk synth --context stage=dev",
    "synth:dev": "cdk synth --context stage=dev",
    "synth:prod": "cdk synth --context stage=prod",
    "deploy": "cdk deploy --context stage=dev --all --require-approval never",
    "deploy:dev": "cdk deploy --context stage=dev --all --require-approval never",
    "deploy:prod": "cdk deploy --context stage=prod --all --require-approval never",
    "diff": "cdk diff --context stage=dev --all",
    "diff:dev": "cdk diff --context stage=dev --all",
    "diff:prod": "cdk diff --context stage=prod --all",
    "destroy:dev": "cdk destroy --context stage=dev --all",
    "destroy:prod": "cdk destroy --context stage=prod --all",
    "typecheck": "tsc -p tsconfig.cdk.json --noEmit && tsc -p tsconfig.lambda.json --noEmit && tsc -p engine-runner/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "fetch:ffmpeg": "bash scripts/fetch-ffmpeg-layer.sh",
    "contract:generate": "ts-node -T --compilerOptions '{\"module\":\"commonjs\",\"target\":\"ES2022\",\"esModuleInterop\":true}' scripts/generate-config-contract.ts",
    "openapi:emit": "ts-node -T --compilerOptions '{\"module\":\"commonjs\",\"target\":\"ES2022\",\"esModuleInterop\":true}' scripts/emit-openapi.ts",
    "test": "vitest run",
    "backfill:telemetry": "ts-node -T --compilerOptions '{\"module\":\"commonjs\",\"target\":\"ES2022\",\"esModuleInterop\":true}' scripts/backfill-telemetry-sessions.ts",
    "smoke": "ts-node -T --compilerOptions '{\"module\":\"commonjs\",\"target\":\"ES2022\",\"esModuleInterop\":true}' scripts/platform-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1063.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1084.0",
    "@aws-sdk/client-ecs": "^3.800.0",
    "@aws-sdk/client-iot": "^3.800.0",
    "@aws-sdk/client-iot-data-plane": "^3.1086.0",
    "@aws-sdk/client-kinesis-video": "^3.800.0",
    "@aws-sdk/client-lambda": "^3.800.0",
    "@aws-sdk/client-rds-data": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/client-sagemaker": "^3.1131.0",
    "@aws-sdk/client-secrets-manager": "^3.800.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1110.0",
    "@aws-sdk/credential-providers": "^3.1088.0",
    "@aws-sdk/s3-presigned-post": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@xorgate/workflow-engine": "0.5.0",
    "aws-jwt-verify": "^5.1.1",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.43.0",
    "mqtt": "^5.15.2",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1114.1",
    "aws-cdk-lib": "2.245.0",
    "constructs": "^10.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.2.0",
    "standardwebhooks": "1.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
