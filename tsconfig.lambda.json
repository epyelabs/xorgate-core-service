{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist/lambda",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // `moduleResolution: node` predates package `exports` maps; the engine's
    // `./local` entry point needs this type-only alias (runtime resolves the
    // exports map natively).
    "baseUrl": ".",
    "paths": {
      "@xorgate/workflow-engine/local": ["node_modules/@xorgate/workflow-engine/dist/cjs/local/index.d.ts"]
    },
    "composite": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "cdk.out"]
}
