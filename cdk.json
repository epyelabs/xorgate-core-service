{
  "app": "npx ts-node --project tsconfig.cdk.json bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig*.json",
      "package*.json",
      "node_modules",
      "cdk.out"
    ]
  },
  "context": {
    "//cognitoEmailViaSes": "Send the pool's emails from xorgate's own SES identity instead of Cognito's default sender. Flip a stage to true ONLY once its SES domain is verified AND its account is out of the SES sandbox; flipping early breaks every signup/invite/reset email.",
    "cognitoEmailViaSes": {
      "dev": true,
      "prod": false
    },
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-ecs:enableExecuteCommand": true,
    "@aws-cdk/aws-rds:databaseProxyUniqueResourceName": true,
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-iam:standardizedServicePrincipals": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/customresources:installLatestAwsSdkDefault": false,
    "@aws-cdk/aws-rds:preventRenderingDeprecatedCredentials": true,
    "@aws-cdk/aws-s3:optimizePathUrlEncoding": true
  }
}
